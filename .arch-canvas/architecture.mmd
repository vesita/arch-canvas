%% @file canvas "src/client/studio.ts"
%% @file picker "src/client/runtime.ts"
%% @file exp "src/client/register.ts"
%% @file rpc "src/package/host.ts#35;apply"
%% @file doc "src/host/document.ts"
%% @file lib "."
%% @file file "src/host/document.ts#35;persist"
%% @file alog "src/host/log.ts"
%% @file prompt "src/host/plugin.ts#35;promptText"
%% @file tools "src/host/plugin.ts#35;onTool"
%% @file bootC "src/bootstrap/client.ts"
%% @file bootH "src/bootstrap/host.ts"
flowchart TD
  subgraph cl["👤 Client 侧 · 与人的交互层"]
    canvas["所见即所得的画布<br/>意图：不写代码也能把结构直接摆出来<br/>原理：图形只是文本的一种视图，改动最终都落回文本"]
    picker["图库管理入口<br/>列图 · 切图 · 改名 · 删除 · 恢复"]
    exp["导出与分享<br/>SVG / PNG / Mermaid 源码"]
  end
  subgraph hs["⚙️ Host 侧 · 真相与持久化层"]
    rpc["浏览器 #60;-> 宿主的通道<br/>~12 个私有 RPC 方法"]
    doc["文档状态管理中心<br/>图模型 · revision 追踪 · 变更通知"]
    parser["Mermaid 编解码器<br/>意图：让「给人看的图」同时是「可编辑的数据」<br/>原理：坐标等元数据寄生在 %% 注释里，文件仍是合法 Mermaid"]
    lib[("图库仓库<br/>项目目录下的 .arch-canvas/")]
    file[("单图文件存储<br/>每张一个 .mmd，坐标与下钻以注释保留")]
    alog[["文件变更日志<br/>按天滚动，保留 3 天"]]
  end
  subgraph ai["🤖 AI 侧 · 读写接口层"]
    prompt["每步注入画布上下文<br/>AI 知道这张图并据此调整行为"]
    tools["AI 操作工具集<br/>arch_read · arch_edit · arch_write · arch_switch"]
  end
  subgraph inv["🧱 不变式 · 任何改动都不应违反"]
    i1["文本是唯一真相源<br/>图形只是文本的一种渲染视图"]
    i2["图不承诺与代码一致<br/>它是辅助讨论的画布，不是代码的镜像"]
    i3["AI 只能增量改图<br/>用户手动摆好的布局不会被冲掉"]
  end
  human(["使用者"])
  bootC[["Client 引导层"]]
  bootH[["Host 引导层"]]
  human -->|"左侧栏点开入口"| bootC
  bootC -->|"初始化时加载 dist/ui.js"| canvas
  bootH -->|"启动时加载 dist/host.js"| rpc
  canvas -->|"每次存图发整份模型"| rpc
  rpc -->|"轻量轮询 revision 同步"| canvas
  picker -->|"列出 / 打开 / 改名 / 删除 / 恢复"| rpc
  exp -->|"读取当前画布内容"| canvas
  rpc --> doc
  doc --> parser
  parser -->|"坐标以 %% @pos 注释写入"| file
  file --> lib
  lib -.->|"周期扫描文件系统发现外部修改"| doc
  rpc -.->|"RPC 异常写日志"| alog
  doc -.->|"保存失败写日志"| alog
  doc -->|"每步 AI 循环注入"| prompt
  tools -->|"只发送增量 op，不动节点布局"| doc
  i1 -.-> parser
  i2 -.-> doc
  i3 -.-> tools
